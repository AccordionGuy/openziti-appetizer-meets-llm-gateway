# Copy to gateway/env.sh, fill in the three keys, and never commit or `cat`
# the result. Source it in every terminal that runs the gateway, `ask`,
# `judge`, or `docker compose up -d classifier`:
#
#   . gateway/env.sh

# From a Claude Console workspace with a spend limit (step 5).
export ANTHROPIC_API_KEY='sk-ant-...'

# Two keys from `llm-gateway genkey` (step 6): one for the classifier, one for you.
export CLASSIFIER_GATEWAY_KEY='sk-gw-...'
export MY_GATEWAY_KEY='sk-gw-...'
